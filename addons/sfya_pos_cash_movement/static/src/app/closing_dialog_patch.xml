<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
        Inherits point_of_sale.ClosePosPopup (the Odoo 18 closing popup template).
        XPath anchor: the <hr/> element that sits between the payment-methods-overview
        div and the Cash Count input area. This is the single <hr/> in the template
        and is a stable anchor in Odoo 18's closing_popup.xml.
        We inject SFYA Customer Receipts / Pay-outs sections after it.
    -->
    <t t-name="sfya_pos_cash_movement.ClosePosPopup"
       t-inherit="point_of_sale.ClosePosPopup"
       t-inherit-mode="extension">
        <xpath expr="//hr" position="after">
            <div t-if="sfya.loaded and (sfya.cash.collects.length or sfya.cash.payouts.length or sfya.cash.drawings.length or sfya.banks.length or sfya.transfers.length)"
                 class="o_sfya_cash_movements mt-2">

                <div t-if="sfya.closeError" class="alert alert-danger mb-2" t-esc="sfya.closeError"/>

                <!-- Cash: collects -->
                <div t-if="sfya.cash.collects.length" class="border rounded p-2 mb-2">
                    <div class="d-flex justify-content-between fw-bold" style="cursor: pointer;"
                         t-on-click="() => sfya.cashCollectsOpen = !sfya.cashCollectsOpen">
                        <span>
                            <i class="fa" t-att-class="sfya.cashCollectsOpen ? 'fa-chevron-down' : 'fa-chevron-right'"/>
                            Customer Receipts (Cash)
                        </span>
                        <span class="text-success">
                            +<t t-esc="sfya.cash.collects_total.toFixed(2)"/>
                        </span>
                    </div>
                    <table t-if="sfya.cashCollectsOpen" class="table table-sm mb-0 mt-1">
                        <tbody>
                            <t t-foreach="sfya.cash.collects" t-as="r" t-key="r.id">
                                <tr>
                                    <td t-esc="r.partner_name"/>
                                    <td t-esc="r.memo"/>
                                    <td class="text-end" t-esc="r.amount.toFixed(2)"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Cash: payouts -->
                <div t-if="sfya.cash.payouts.length" class="border rounded p-2 mb-2">
                    <div class="d-flex justify-content-between fw-bold" style="cursor: pointer;"
                         t-on-click="() => sfya.cashPayoutsOpen = !sfya.cashPayoutsOpen">
                        <span>
                            <i class="fa" t-att-class="sfya.cashPayoutsOpen ? 'fa-chevron-down' : 'fa-chevron-right'"/>
                            Pay-outs (Cash)
                        </span>
                        <span class="text-warning">
                            -<t t-esc="sfya.cash.payouts_total.toFixed(2)"/>
                        </span>
                    </div>
                    <table t-if="sfya.cashPayoutsOpen" class="table table-sm mb-0 mt-1">
                        <tbody>
                            <t t-foreach="sfya.cash.payouts" t-as="r" t-key="r.id">
                                <tr>
                                    <td t-esc="r.partner_name"/>
                                    <td t-esc="r.memo"/>
                                    <td class="text-end" t-esc="r.amount.toFixed(2)"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Cash: drawings -->
                <div t-if="sfya.cash.drawings.length" class="border rounded p-2 mb-2">
                    <div class="d-flex justify-content-between fw-bold" style="cursor: pointer;"
                         t-on-click="() => sfya.drawingsOpen = !sfya.drawingsOpen">
                        <span>
                            <i class="fa" t-att-class="sfya.drawingsOpen ? 'fa-chevron-down' : 'fa-chevron-right'"/>
                             Partner Drawings (Cash)
                        </span>
                        <span class="text-info">-<t t-esc="sfya.cash.drawings_total.toFixed(2)"/></span>
                    </div>
                    <table t-if="sfya.drawingsOpen" class="table table-sm mb-0 mt-1">
                        <tbody>
                            <t t-foreach="sfya.cash.drawings" t-as="d" t-key="d.id">
                                <tr>
                                    <td t-esc="d.partner_name"/>
                                    <td class="text-muted" t-esc="d.memo"/>
                                    <td class="text-end" t-esc="d.amount.toFixed(2)"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Partner transfers: no cash/bank leg at all, informational only -->
                <div t-if="sfya.transfers.length" class="border rounded p-2 mb-2">
                    <div class="d-flex justify-content-between fw-bold" style="cursor: pointer;"
                         t-on-click="() => sfya.transfersOpen = !sfya.transfersOpen">
                        <span>
                            <i class="fa" t-att-class="sfya.transfersOpen ? 'fa-chevron-down' : 'fa-chevron-right'"/>
                            Partner Transfers
                            <small class="text-muted ms-2">(informational, no till impact)</small>
                        </span>
                        <span class="text-muted">
                            <t t-esc="sfyaTransfersTotal.toFixed(2)"/>
                        </span>
                    </div>
                    <table t-if="sfya.transfersOpen" class="table table-sm mb-0 mt-1">
                        <tbody>
                            <t t-foreach="sfya.transfers" t-as="r" t-key="r.id">
                                <tr>
                                    <td><t t-esc="r.to_partner_name"/> <small class="text-muted">via <t t-esc="r.from_partner_name"/></small></td>
                                    <td t-esc="r.memo"/>
                                    <td class="text-end" t-esc="r.amount.toFixed(2)"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Banks: one section per journal, informational only -->
                <t t-foreach="sfya.banks" t-as="b" t-key="b.journal_id">
                    <div class="border rounded p-2 mb-2">
                        <div class="d-flex justify-content-between fw-bold" style="cursor: pointer;"
                             t-on-click="() => this.toggleSfyaBank(b.journal_id)">
                            <span>
                                <i class="fa" t-att-class="sfya.banksOpen[b.journal_id] ? 'fa-chevron-down' : 'fa-chevron-right'"/>
                                <t t-esc="b.journal_name"/>
                                <small class="text-muted ms-2">(informational, no till impact)</small>
                            </span>
                            <span>
                                <span class="text-success me-2">+<t t-esc="b.collects_total.toFixed(2)"/></span>
                                <span class="text-warning">-<t t-esc="b.payouts_total.toFixed(2)"/></span>
                            </span>
                        </div>
                        <table t-if="sfya.banksOpen[b.journal_id]" class="table table-sm mb-0 mt-1">
                            <tbody>
                                <t t-foreach="b.collects" t-as="r" t-key="'c'+r.id">
                                    <tr>
                                        <td>+</td>
                                        <td t-esc="r.partner_name"/>
                                        <td t-esc="r.memo"/>
                                        <td class="text-end" t-esc="r.amount.toFixed(2)"/>
                                    </tr>
                                </t>
                                <t t-foreach="b.payouts" t-as="r" t-key="'p'+r.id">
                                    <tr>
                                        <td>−</td>
                                        <td t-esc="r.partner_name"/>
                                        <td t-esc="r.memo"/>
                                        <td class="text-end" t-esc="r.amount.toFixed(2)"/>
                                    </tr>
                                </t>
                                <t t-foreach="b.drawings or []" t-as="r" t-key="'d'+r.id">
                                    <tr>
                                        <td>−</td>
                                        <td t-esc="r.partner_name"/>
                                        <td t-esc="r.memo"/>
                                        <td class="text-end" t-esc="r.amount.toFixed(2)"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>
        </xpath>
    </t>
</templates>
