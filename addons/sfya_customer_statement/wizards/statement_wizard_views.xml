<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_statement_wizard_form" model="ir.ui.view">
        <field name="name">sfya.statement.wizard.form</field>
        <field name="model">sfya.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Statement">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="include_drafts"/>
                            <field name="show_aging"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_view_html" type="object"
                            string="View" class="btn-primary"/>
                    <button name="action_print_pdf" type="object"
                            string="Print PDF" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_statement_wizard" model="ir.actions.act_window">
        <field name="name">Customer Statement</field>
        <field name="res_model">sfya.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
