<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_customer_statement">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <style>
                        table.stmt td:nth-child(1), table.stmt th:nth-child(1),
                        table.stmt td:nth-child(2), table.stmt th:nth-child(2),
                        table.stmt td:nth-child(3), table.stmt th:nth-child(3),
                        table.stmt td:nth-child(7), table.stmt th:nth-child(7),
                        table.stmt td:nth-child(8), table.stmt th:nth-child(8),
                        table.stmt td:nth-child(9), table.stmt th:nth-child(9) {
                            border-right: 1px solid #dee2e6;
                        }
                        table.stmt tbody td { border-top: 0; }
                        table.stmt tbody tr.entry-start td { border-top: 2px solid #adb5bd; }
                    </style>
                    <h2>Customer Statement</h2>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong t-esc="data['partner']['name']"/>
                            <div t-if="data['partner']['street']" t-esc="data['partner']['street']"/>
                            <div t-if="data['partner']['phone']">Phone: <span t-esc="data['partner']['phone']"/></div>
                            <div t-if="data['partner']['email']">Email: <span t-esc="data['partner']['email']"/></div>
                            <div t-if="data['partner']['vat']">VAT: <span t-esc="data['partner']['vat']"/></div>
                        </div>
                        <div class="col-6 text-right">
                            <div>Period: <span t-esc="data['date_from_str']"/> to <span t-esc="data['date_to_str']"/></div>
                            <div>Opening Balance:
                                <span t-esc="'%s %.2f' % (data['currency_symbol'], data['opening_balance'])"/>
                            </div>
                            <div><strong>Closing Balance:
                                <span t-esc="'%s %.2f' % (data['currency_symbol'], data['closing_balance'])"/>
                            </strong></div>
                        </div>
                    </div>

                    <table class="table table-sm stmt">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Voucher</th>
                                <th>Type</th>
                                <th>Descriptions</th>
                                <th class="text-right">Qty</th>
                                <th class="text-right">@</th>
                                <th class="text-right">Amount</th>
                                <th class="text-right">Debit</th>
                                <th class="text-right">Credit</th>
                                <th class="text-right">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="entry-start">
                                <td t-esc="data['opening_row']['date_str']"/>
                                <td t-esc="data['opening_row']['doc_name']"/>
                                <td>Opening</td>
                                <td t-esc="data['opening_row']['note']"/>
                                <td/>
                                <td/>
                                <td/>
                                <td class="text-right">
                                    <t t-if="data['opening_row']['debit']" t-esc="'%.2f' % data['opening_row']['debit']"/>
                                </td>
                                <td class="text-right">
                                    <t t-if="data['opening_row']['credit']" t-esc="'%.2f' % data['opening_row']['credit']"/>
                                </td>
                                <td class="text-right" t-esc="'%.2f' % data['opening_row']['balance']"/>
                            </tr>

                            <t t-foreach="data['rows']" t-as="row">
                                <t t-if="not row['lines']">
                                    <tr class="entry-start">
                                        <td t-esc="row['date_str']"/>
                                        <td t-esc="row['doc_name']"/>
                                        <td t-esc="row['kind_label']"/>
                                        <td t-esc="row['note']"/>
                                        <td/>
                                        <td/>
                                        <td/>
                                        <td class="text-right">
                                            <t t-if="row['debit']" t-esc="'%.2f' % row['debit']"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-if="row['credit']" t-esc="'%.2f' % row['credit']"/>
                                        </td>
                                        <td class="text-right" t-esc="'%.2f' % row['balance']"/>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <t t-set="rspan" t-value="len(row['lines'])"/>
                                    <t t-foreach="row['lines']" t-as="line">
                                        <tr t-att-class="'entry-start' if line_first else ''">
                                            <t t-if="line_first">
                                                <td class="align-middle" t-att-rowspan="rspan" t-esc="row['date_str']"/>
                                                <td class="align-middle" t-att-rowspan="rspan" t-esc="row['doc_name']"/>
                                                <td class="align-middle" t-att-rowspan="rspan" t-esc="row['kind_label']"/>
                                            </t>
                                            <td t-esc="line['name']"/>
                                            <td class="text-right" t-esc="'%g' % line['qty']"/>
                                            <td class="text-right" t-esc="'%.2f' % line['price_unit']"/>
                                            <td class="text-right" t-esc="'%.2f' % line['subtotal']"/>
                                            <t t-if="line_first">
                                                <td class="text-right align-middle" t-att-rowspan="rspan">
                                                    <t t-if="row['debit']" t-esc="'%.2f' % row['debit']"/>
                                                </td>
                                                <td class="text-right align-middle" t-att-rowspan="rspan">
                                                    <t t-if="row['credit']" t-esc="'%.2f' % row['credit']"/>
                                                </td>
                                                <td class="text-right align-middle" t-att-rowspan="rspan" t-esc="'%.2f' % row['balance']"/>
                                            </t>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <div class="row" t-if="data['aging']">
                        <div class="col-12">
                            <h4>Aging (Open Items at <span t-esc="data['date_to_str']"/>)</h4>
                            <table class="table table-sm" style="width: 60%;">
                                <thead>
                                    <tr>
                                        <th>Bucket</th>
                                        <th class="text-right">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data['aging']" t-as="bucket">
                                        <td t-esc="bucket['label']"/>
                                        <td class="text-right" t-esc="'%s %.2f' % (data['currency_symbol'], bucket['amount'])"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
