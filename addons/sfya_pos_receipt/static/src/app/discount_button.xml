<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="sfya_pos_receipt.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <button class="control-button btn btn-secondary btn-lg py-5 o_sfya_discount_button"
                    t-on-click="openDiscountPopup">
                <i class="fa fa-tag text-primary me-1"/>
                Discount
            </button>
        </xpath>
    </t>
</templates>
